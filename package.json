{
  "name": "strategos",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "pnpm build:shared",
    "build:shared": "pnpm --filter @strategos/shared build",
    "build": "pnpm -r build",
    "dev": "pnpm build:shared && pnpm --parallel --filter @strategos/backend --filter @strategos/frontend dev",
    "db:up": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm -r test",
    "test:e2e": "pnpm build:shared && pnpm --filter @strategos/backend test:e2e",
    "openapi": "pnpm --filter @strategos/backend build && pnpm --filter @strategos/backend exec node dist/src/cli/openapi.js",
    "test:browser": "pnpm build:shared && pnpm --filter @strategos/backend build && pnpm --filter @strategos/e2e browser",
    "test:browser:install": "pnpm --filter @strategos/e2e exec playwright install chromium",
    "audit:deps": "pnpm audit --audit-level=moderate",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.12.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
