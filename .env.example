# Copier en .env puis adapter. Valeurs par défaut adaptées au lancement local.

# Nom de domaine servi par Caddy (certificat automatique). "localhost" = certificat interne.
DOMAIN=localhost

POSTGRES_USER=strategos
POSTGRES_PASSWORD=strategos
POSTGRES_DB=strategos

# --- Sources connectées (étape 7) ---
# Google Sheets : déposer la clé JSON du compte de service dans secrets/google-service-account.json
# (monté en lecture seule dans le conteneur, jamais dans l'image ni en base).
# OneDrive : application Azure (adresse de retour : https://<DOMAIN>/api/v1/onedrive/callback).
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT=common
# Clé de chiffrement du jeton OneDrive : 32 octets en base64 (openssl rand -base64 32).
TOKEN_ENCRYPTION_KEY=
