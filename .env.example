# Copier en .env puis adapter. Valeurs par défaut adaptées au lancement local.

# Nom de domaine servi par Caddy (certificat automatique). "localhost" = certificat interne.
DOMAIN=localhost

# Fuseau horaire du backend : la sauvegarde quotidienne part à 3 h de ce fuseau.
TZ=Europe/Paris

POSTGRES_USER=strategos
POSTGRES_PASSWORD=strategos
POSTGRES_DB=strategos

# --- Sources connectées (étape 7) ---
# Google Sheets : projet Google Cloud (voir references/deploiement.md). Client OAuth
# « application Web » (adresse de retour : https://<DOMAIN>/api/v1/google/callback) et clé d'API
# du sélecteur de fichiers. L'administrateur connecte ensuite son compte depuis Admin › Sources.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
# OneDrive : application Azure (adresse de retour : https://<DOMAIN>/api/v1/onedrive/callback).
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT=common
# Clé de chiffrement des jetons Google et OneDrive : 32 octets en base64 (openssl rand -base64 32).
TOKEN_ENCRYPTION_KEY=
