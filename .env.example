# Copier en .env puis adapter (chmod 600 .env : il contient des secrets).

# Nom de domaine servi par Caddy (certificat automatique). "localhost" = certificat interne.
DOMAIN=localhost

# HSTS : le navigateur n'accepte plus que du HTTPS valide pour ce domaine pendant un an.
# À désactiver (HSTS=max-age=0) sur un réseau interne tant que le certificat de Caddy
# n'est pas installé sur les postes : l'alerte du navigateur deviendrait infranchissable.
# HSTS=max-age=31536000

# Fuseau horaire du backend : la sauvegarde quotidienne part à 3 h de ce fuseau.
TZ=Europe/Paris

POSTGRES_USER=strategos
# Obligatoire : sans lui, rien ne démarre. En production : openssl rand -hex 24, choisi
# avant le premier lancement. Sur un poste de développement, garder « strategos » :
# c'est le mot de passe qu'attendent `pnpm dev` et les tests.
POSTGRES_PASSWORD=
POSTGRES_DB=strategos

# --- Sources connectées (étape 7) ---
# Google Sheets : rien à régler ici en général. L'administrateur saisit les identifiants Google
# dans Admin › Sources, où un guide l'accompagne. Si vous installez le site pour quelqu'un
# d'autre, vous pouvez les fournir ici : ils ont priorité et le formulaire est masqué
# (voir references/deploiement.md, section 10).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_API_KEY=
# OneDrive : application Azure (adresse de retour : https://<DOMAIN>/api/v1/onedrive/callback).
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT=common
# Clé de chiffrement des secrets gardés en base (jetons Google et OneDrive) : facultative.
# Vide, le backend en crée une dans le volume `keys`. Sinon : openssl rand -base64 32.
TOKEN_ENCRYPTION_KEY=
