// Modèle de données : voir references/conception/14-modele-donnees.md.
// Ce que Prisma n'exprime pas (CHECK, index partiels, trigger, extensions) est
// ajouté en SQL dans les migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1. Types enum (ordre de création, 14 §13). Ils doivent rester identiques à
// packages/shared/src/enums.ts (vérifié par src/prisma/enums.spec.ts).

enum BackupStatus {
  running
  ok
  failed

  @@map("backup_status")
}

enum LayoutKind {
  header
  footer

  @@map("layout_kind")
}

enum TopicSort {
  activity
  created

  @@map("topic_sort")
}

enum RevisionAction {
  edit
  delete
  hide
  unhide

  @@map("revision_action")
}

enum SourceType {
  upload
  gsheet
  onedrive

  @@map("source_type")
}

enum SourceStatus {
  ok
  unavailable
  auth_expired

  @@map("source_status")
}

enum CellType {
  empty
  text
  number
  bool
  date
  error

  @@map("cell_type")
}

enum FormMode {
  modification
  ligne
  ajout

  @@map("form_mode")
}

enum SubmissionStatus {
  pending
  validated
  rejected
  modified
  invalidated

  @@map("submission_status")
}

enum TemplateType {
  form
  page
  topic

  @@map("template_type")
}

enum ActorKind {
  user
  system
  cli

  @@map("actor_kind")
}

// 2. Comptes et sessions (14 §2).
// SQL ajouté dans la migration : extension citext, index uniques partiels
// (username) where deleted_at is null, (is_admin) where is_admin.

model User {
  id                    String    @id @default(uuid(7)) @db.Uuid
  username              String    @db.Citext
  passwordHash          String    @map("password_hash")
  isAdmin               Boolean   @default(false) @map("is_admin")
  mustChangeCredentials Boolean   @default(true) @map("must_change_credentials")
  /// FK vers pages ajoutée à l'étape 3 (14 §13, point 4).
  personalPageId        String?   @map("personal_page_id") @db.Uuid
  disabledAt            DateTime? @map("disabled_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz
  version               Int       @default(1)

  sessions  Session[]
  auditLogs AuditLog[]

  @@map("users")
}

model Session {
  /// Empreinte SHA-256 du jeton ; le jeton en clair n'est jamais stocké.
  id         String   @id
  userId     String   @map("user_id") @db.Uuid
  csrfSecret String   @map("csrf_secret")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  ip         String?
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  id        String   @id @default(uuid(7)) @db.Uuid
  username  String   @db.Citext
  ip        String   @db.Inet
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([username, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

// 11. Journal (14 §11). SQL ajouté dans la migration : trigger d'ajout seul.

model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  actorKind  ActorKind @map("actor_kind")
  /// Vide si l'acteur est `system` ou `cli`.
  actorId    String?   @map("actor_id") @db.Uuid
  action     String
  targetType String    @map("target_type")
  targetId   String?   @map("target_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?   @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_log")
}
