// Modèle de données : voir references/conception/14-modele-donnees.md.
// Ce que Prisma n'exprime pas (CHECK, index partiels, trigger, extensions) est
// ajouté en SQL dans les migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1. Types enum (ordre de création, 14 §13). Ils doivent rester identiques à
// packages/shared/src/enums.ts (vérifié par src/prisma/enums.spec.ts).

enum BackupStatus {
  running
  ok
  failed

  @@map("backup_status")
}

enum LayoutKind {
  header
  footer

  @@map("layout_kind")
}

enum TopicSort {
  activity
  created

  @@map("topic_sort")
}

enum RevisionAction {
  edit
  delete
  hide
  unhide

  @@map("revision_action")
}

enum SourceType {
  upload
  gsheet
  onedrive

  @@map("source_type")
}

enum SourceStatus {
  ok
  unavailable
  auth_expired

  @@map("source_status")
}

enum CellType {
  empty
  text
  number
  bool
  date
  error

  @@map("cell_type")
}

enum FormMode {
  modification
  ligne
  ajout

  @@map("form_mode")
}

enum SubmissionStatus {
  pending
  validated
  rejected
  modified
  invalidated

  @@map("submission_status")
}

enum TemplateType {
  form
  page
  topic

  @@map("template_type")
}

enum ActorKind {
  user
  system
  cli

  @@map("actor_kind")
}

// 2. Comptes et sessions (14 §2).
// SQL ajouté dans la migration : extension citext, index uniques partiels
// (username) where deleted_at is null, (is_admin) where is_admin.

model User {
  id                    String    @id @default(uuid(7)) @db.Uuid
  username              String    @db.Citext
  passwordHash          String    @map("password_hash")
  isAdmin               Boolean   @default(false) @map("is_admin")
  mustChangeCredentials Boolean   @default(true) @map("must_change_credentials")
  personalPageId        String?   @map("personal_page_id") @db.Uuid
  disabledAt            DateTime? @map("disabled_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz
  version               Int       @default(1)

  sessions       Session[]
  auditLogs      AuditLog[]
  personalPage   Page?             @relation("PersonalPage", fields: [personalPageId], references: [id], onDelete: SetNull)
  publishedPages Page[]            @relation("PublishedBy")
  media          Media[]
  groups         UserGroup[]
  sources        Source[]
  reimports      ReimportPreview[]
  cellEdits      SourceCellEdit[]
  formVersions   FormVersion[]
  submissions    Submission[]      @relation("SubmissionAuthor")
  decisions      Submission[]      @relation("SubmissionDecider")
  topics             Topic[]
  messages           TopicMessage[]    @relation("MessageAuthor")
  hiddenMessages     TopicMessage[]    @relation("MessageHider")
  chatMessages       ChatMessage[]     @relation("ChatMessageAuthor")
  hiddenChatMessages ChatMessage[]     @relation("ChatMessageHider")
  revisions          MessageRevision[]
  attachments        Attachment[]
  notes              UserNote[]
  templates          Template[]

  @@map("users")
}

model Session {
  /// Empreinte SHA-256 du jeton ; le jeton en clair n'est jamais stocké.
  id         String   @id
  userId     String   @map("user_id") @db.Uuid
  csrfSecret String   @map("csrf_secret")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  ip         String?
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  id        String   @id @default(uuid(7)) @db.Uuid
  username  String   @db.Citext
  ip        String   @db.Inet
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([username, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

// 3. Groupes et droits (14 §3). SQL ajouté dans la migration : index unique
// partiel groups(name) where deleted_at is null, contraintes CHECK de
// group_permissions.

model Group {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.Citext
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  version     Int       @default(1)

  members     UserGroup[]
  permissions GroupPermission[]

  @@map("groups")
}

/// Les appartenances d'un compte ou d'un groupe supprimés sont conservées, mais
/// ignorées par la résolution des droits.
model UserGroup {
  userId    String   @map("user_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  group Group @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([userId, groupId])
  @@index([groupId])
  @@map("user_groups")
}

/// Cible : exactement une page ou un espace ; une page n'accorde que la lecture.
model GroupPermission {
  id             String   @id @default(uuid(7)) @db.Uuid
  groupId        String   @map("group_id") @db.Uuid
  pageId         String?  @map("page_id") @db.Uuid
  spaceId        String?  @map("space_id") @db.Uuid
  canRead        Boolean  @default(false) @map("can_read")
  canCreateTopic Boolean  @default(false) @map("can_create_topic")
  canPost        Boolean  @default(false) @map("can_post")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  group Group            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  page  Page?            @relation(fields: [pageId], references: [id], onDelete: Restrict)
  space DiscussionSpace? @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  @@unique([groupId, pageId])
  @@unique([groupId, spaceId])
  @@index([pageId])
  @@index([spaceId])
  @@map("group_permissions")
}

// 4. Instance, thèmes, médias (14 §4). SQL ajouté dans la migration :
// CHECK settings, index unique partiel media(filename), données initiales.

model Setting {
  id                  Int      @id @default(1) @db.SmallInt
  landingPageId       String?  @map("landing_page_id") @db.Uuid
  defaultThemeId      String?  @map("default_theme_id") @db.Uuid
  backupRetentionDays Int      @default(7) @map("backup_retention_days")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  version             Int      @default(1)

  landingPage  Page?  @relation(fields: [landingPageId], references: [id], onDelete: SetNull)
  defaultTheme Theme? @relation(fields: [defaultThemeId], references: [id], onDelete: Restrict)

  @@map("settings")
}

model Theme {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique @db.Citext
  config    Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  version   Int      @default(1)

  pages    Page[]
  settings Setting[]

  @@map("themes")
}

model Media {
  id          String    @id @default(uuid(7)) @db.Uuid
  filename    String
  storagePath String    @map("storage_path")
  mime        String
  sizeBytes   BigInt    @map("size_bytes")
  alt         String?
  uploadedBy  String    @map("uploaded_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  uploader User @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@map("media")
}

// 5. Pages (14 §5).

model Page {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String
  /// Thème de la version publiée ; vide = thème par défaut.
  themeId         String?   @map("theme_id") @db.Uuid
  showHeader      Boolean   @default(true) @map("show_header")
  showFooter      Boolean   @default(true) @map("show_footer")
  draftConfig     Json      @default("{}") @map("draft_config")
  publishedConfig Json?     @map("published_config")
  publishedAt     DateTime? @map("published_at") @db.Timestamptz
  publishedBy     String?   @map("published_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  version         Int       @default(1)

  theme       Theme?            @relation(fields: [themeId], references: [id], onDelete: SetNull)
  publisher   User?             @relation("PublishedBy", fields: [publishedBy], references: [id], onDelete: Restrict)
  personalOf  User[]            @relation("PersonalPage")
  landingOf   Setting[]
  permissions GroupPermission[]
  spaces      DiscussionSpace[]
  chats       Chat[]
  forms       Form[]

  @@map("pages")
}

model LayoutPart {
  kind            LayoutKind @id
  draftConfig     Json       @default("{}") @map("draft_config")
  publishedConfig Json?      @map("published_config")
  publishedAt     DateTime?  @map("published_at") @db.Timestamptz
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  version         Int        @default(1)

  @@map("layout_parts")
}

// 6. Discussions (14 §6). `discussion_spaces` est créée dès l'étape 4, pour
// que `group_permissions` puisse la viser ; elle reste vide jusqu'à l'étape 8.

model DiscussionSpace {
  id        String    @id @default(uuid(7)) @db.Uuid
  pageId    String    @map("page_id") @db.Uuid
  /// Id du bloc dans la page.
  blockId   String    @unique @map("block_id") @db.Uuid
  name      String
  sortMode  TopicSort @default(activity) @map("sort_mode")
  /// Ligne créée à la publication de la page.
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  page        Page              @relation(fields: [pageId], references: [id], onDelete: Restrict)
  permissions GroupPermission[]
  topics      Topic[]

  @@map("discussion_spaces")
}

model Topic {
  id             String    @id @default(uuid(7)) @db.Uuid
  spaceId        String    @map("space_id") @db.Uuid
  authorId       String    @map("author_id") @db.Uuid
  title          String
  closedAt       DateTime? @map("closed_at") @db.Timestamptz
  pinnedAt       DateTime? @map("pinned_at") @db.Timestamptz
  /// Mis à jour à chaque message (tri « activité »).
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  space    DiscussionSpace @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  author   User            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  messages TopicMessage[]

  // Index partiel (épinglés puis activité récente) complété en SQL.
  @@map("topics")
}

model TopicMessage {
  id        String    @id @default(uuid(7)) @db.Uuid
  topicId   String    @map("topic_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  /// Texte nettoyé (liste blanche).
  content   String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  editedAt  DateTime? @map("edited_at") @db.Timestamptz
  hiddenAt  DateTime? @map("hidden_at") @db.Timestamptz
  hiddenBy  String?   @map("hidden_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  topic       Topic             @relation(fields: [topicId], references: [id], onDelete: Restrict)
  author      User              @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  hider       User?             @relation("MessageHider", fields: [hiddenBy], references: [id], onDelete: SetNull)
  revisions   MessageRevision[]
  attachments Attachment[]

  @@index([topicId, id])
  @@map("topic_messages")
}

/// Chat temps réel (07 — Chat). Créé à la publication de la page qui contient
/// son bloc, comme les espaces ; accessible à qui peut lire la page (pas une
/// ressource du modèle de droits).
model Chat {
  id        String    @id @default(uuid(7)) @db.Uuid
  pageId    String    @map("page_id") @db.Uuid
  /// Id du bloc dans la page.
  blockId   String    @unique @map("block_id") @db.Uuid
  name      String
  /// Ligne créée à la publication de la page.
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  page     Page          @relation(fields: [pageId], references: [id], onDelete: Restrict)
  messages ChatMessage[]

  @@map("chats")
}

model ChatMessage {
  id        String    @id @default(uuid(7)) @db.Uuid
  chatId    String    @map("chat_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  /// Texte nettoyé (liste blanche).
  content   String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  editedAt  DateTime? @map("edited_at") @db.Timestamptz
  hiddenAt  DateTime? @map("hidden_at") @db.Timestamptz
  hiddenBy  String?   @map("hidden_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  chat        Chat              @relation(fields: [chatId], references: [id], onDelete: Restrict)
  author      User              @relation("ChatMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  hider       User?             @relation("ChatMessageHider", fields: [hiddenBy], references: [id], onDelete: SetNull)
  revisions   MessageRevision[]
  attachments Attachment[]

  @@index([chatId, id])
  @@map("chat_messages")
}

/// Archive des versions précédentes et des masquages (07 — Points techniques).
/// `CHECK (num_nonnulls(...) = 1)` complété en SQL.
model MessageRevision {
  id              String         @id @default(uuid(7)) @db.Uuid
  topicMessageId  String?        @map("topic_message_id") @db.Uuid
  chatMessageId   String?        @map("chat_message_id") @db.Uuid
  action          RevisionAction
  /// Contenu avant l'action.
  previousContent String         @map("previous_content")
  actorId         String         @map("actor_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  topicMessage TopicMessage? @relation(fields: [topicMessageId], references: [id], onDelete: Cascade)
  chatMessage  ChatMessage?  @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  actor        User          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([topicMessageId])
  @@index([chatMessageId])
  @@map("message_revisions")
}

/// Pièces jointes images (07).
/// `CHECK (num_nonnulls(...) <= 1)` et `CHECK (size_bytes <= 5242880)` en SQL.
model Attachment {
  id             String   @id @default(uuid(7)) @db.Uuid
  uploaderId     String   @map("uploader_id") @db.Uuid
  topicMessageId String?  @map("topic_message_id") @db.Uuid
  chatMessageId  String?  @map("chat_message_id") @db.Uuid
  storagePath    String   @map("storage_path")
  mime           String
  sizeBytes      Int      @map("size_bytes")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  uploader     User          @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  topicMessage TopicMessage? @relation(fields: [topicMessageId], references: [id], onDelete: Cascade)
  chatMessage  ChatMessage?  @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  @@index([topicMessageId])
  @@index([chatMessageId])
  @@map("attachments")
}

// 7. Sources de données (14 §7).

model Source {
  id               String       @id @default(uuid(7)) @db.Uuid
  type             SourceType
  /// Nom affiché : nom du fichier ou du Sheet.
  name             String
  /// `upload` : `storagePath` ; `gsheet` : `spreadsheetId` ; `onedrive` : `driveId`, `itemId`.
  connectionInfo   Json         @map("connection_info")
  status           SourceStatus @default(ok)
  lastReadAt       DateTime?    @map("last_read_at") @db.Timestamptz
  lastImportedAt   DateTime?    @map("last_imported_at") @db.Timestamptz
  lastDownloadedAt DateTime?    @map("last_downloaded_at") @db.Timestamptz
  createdBy        String       @map("created_by") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz
  version          Int          @default(1)

  creator    User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  cells      StagingCell[]
  references CellReference[]   @relation("ReferencingSource")
  referenced CellReference[]   @relation("ReferencedSource")
  reimports  ReimportPreview[]
  cellEdits  SourceCellEdit[]

  @@map("sources")
}

/// Excel uploadés uniquement ; seules les cellules non vides sont stockées.
model StagingCell {
  sourceId    String   @map("source_id") @db.Uuid
  sheet       String
  row         Int
  col         Int
  valueType   CellType @map("value_type")
  valueText   String?  @map("value_text")
  valueNumber Decimal? @map("value_number") @db.Decimal
  formula     String?
  needsRecalc Boolean  @default(false) @map("needs_recalc")

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([sourceId, sheet, row, col])
  @@map("staging_cells")
}

/// Modification d'une cellule par l'admin dans la grille d'un Excel uploadé
/// (04 — Sources) : `before` / `after` = `{ type, text, number, formula }`.
/// Sert au réimport : une modification postérieure au dernier téléchargement
/// peut être perdue, puis réappliquée.
model SourceCellEdit {
  id        String   @id @default(uuid(7)) @db.Uuid
  sourceId  String   @map("source_id") @db.Uuid
  sheet     String
  row       Int
  col       Int
  before    Json
  after     Json
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  source  Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([sourceId, createdAt])
  @@map("source_cell_edits")
}

/// Liaison inter-fichiers : résolue par source, jamais par chemin.
model CellReference {
  id                 String @id @default(uuid(7)) @db.Uuid
  sourceId           String @map("source_id") @db.Uuid
  sheet              String
  row                Int
  col                Int
  referencedSourceId String @map("referenced_source_id") @db.Uuid
  referencedSheet    String @map("referenced_sheet")
  referencedRange    String @map("referenced_range")

  source           Source @relation("ReferencingSource", fields: [sourceId], references: [id], onDelete: Cascade)
  referencedSource Source @relation("ReferencedSource", fields: [referencedSourceId], references: [id], onDelete: Restrict)

  @@index([sourceId, sheet, row, col])
  @@index([referencedSourceId, referencedSheet])
  @@map("cell_references")
}

/// Connexion OneDrive de l'admin (accès délégué) : une seule ligne, `id = 1`
/// (`CHECK` ajouté dans la migration). Le refresh token est chiffré (AES-256-GCM).
model OnedriveCredential {
  id                    Int       @id @default(1)
  /// Compte Microsoft connecté, affiché dans l'espace admin.
  accountLabel          String    @map("account_label")
  refreshTokenEncrypted Bytes     @map("refresh_token_encrypted")
  accessExpiresAt       DateTime? @map("access_expires_at") @db.Timestamptz
  /// Rafraîchissement refusé par Microsoft : l'admin doit se reconnecter.
  expiredAt             DateTime? @map("expired_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("onedrive_credentials")
}

/// Connexion du compte Google de l'admin (accès délégué, limité aux fichiers
/// qu'il choisit) : une seule ligne, `id = 1` (`CHECK` ajouté dans la migration).
/// Le refresh token est chiffré (AES-256-GCM).
model GoogleCredential {
  id                    Int       @id @default(1)
  /// Compte Google connecté, affiché dans l'espace admin.
  accountLabel          String    @map("account_label")
  refreshTokenEncrypted Bytes     @map("refresh_token_encrypted")
  accessExpiresAt       DateTime? @map("access_expires_at") @db.Timestamptz
  /// Rafraîchissement refusé par Google : l'admin doit se reconnecter.
  expiredAt             DateTime? @map("expired_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("google_credentials")
}

model ReimportPreview {
  id               String   @id @default(uuid(7)) @db.Uuid
  sourceId         String   @map("source_id") @db.Uuid
  uploadedFilePath String   @map("uploaded_file_path")
  lostValidations  Json     @map("lost_validations")
  createdBy        String   @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  expiresAt        DateTime @map("expires_at") @db.Timestamptz

  source  Source @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  creator User   @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@map("reimport_previews")
}

// 8. Formulaires et soumissions (14 §8). SQL ajouté dans la migration :
// check (status = 'pending' or decided_at is not null), index GIN partiel
// (conflict_keys) where status = 'pending', index (user_id, created_at desc).

model Form {
  id               String    @id @default(uuid(7)) @db.Uuid
  pageId           String    @map("page_id") @db.Uuid
  /// Id du bloc `form` dans la page.
  blockId          String    @unique @map("block_id") @db.Uuid
  mode             FormMode
  /// Définition en brouillon : champs, mappings, zone, clé.
  draftDefinition  Json      @map("draft_definition")
  /// Version en ligne ; vide = jamais publié.
  publishedVersion Int?      @map("published_version")
  isOpen           Boolean   @default(true) @map("is_open")
  closesAt         DateTime? @map("closes_at") @db.Timestamptz
  autoValidate     Boolean   @default(false) @map("auto_validate")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz
  /// Verrouillage optimiste (≠ `published_version`).
  version          Int       @default(1)

  page        Page          @relation(fields: [pageId], references: [id], onDelete: Restrict)
  versions    FormVersion[] @relation("FormVersions")
  published   FormVersion?  @relation("PublishedFormVersion", fields: [id, publishedVersion], references: [formId, version], onDelete: Restrict, onUpdate: Restrict)
  submissions Submission[]

  @@map("forms")
}

model FormVersion {
  formId      String   @map("form_id") @db.Uuid
  version     Int
  /// Définition figée à la publication.
  definition  Json
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz
  publishedBy String   @map("published_by") @db.Uuid

  form        Form         @relation("FormVersions", fields: [formId], references: [id], onDelete: Restrict)
  publishedOf Form[]       @relation("PublishedFormVersion")
  publisher   User         @relation(fields: [publishedBy], references: [id], onDelete: Restrict)
  submissions Submission[]

  @@id([formId, version])
  @@map("form_versions")
}

model Submission {
  id           String           @id @default(uuid(7)) @db.Uuid
  formId       String           @map("form_id") @db.Uuid
  formVersion  Int              @map("form_version")
  userId       String           @map("user_id") @db.Uuid
  /// Valeurs soumises, y compris les champs automatiques.
  values       Json
  /// Valeur de la clé (formulaire de ligne).
  rowKey       String?          @map("row_key")
  /// Cellules visées, calculées à la soumission ; les mouvements n'en produisent pas.
  conflictKeys String[]         @default([]) @map("conflict_keys")
  status       SubmissionStatus @default(pending)
  /// Ligne attribuée à un ajout, à la validation.
  assignedRow  Int?             @map("assigned_row")
  /// Ce qui a réellement été écrit : `{ values, cells: [{ sourceId, sheet, row, col, before, after, movement? }] }`.
  written      Json?
  /// Motif de refus ou d'invalidation.
  reason       String?
  decidedAt    DateTime?        @map("decided_at") @db.Timestamptz
  /// Vide avec `validated` = validation automatique (« système »).
  decidedBy    String?          @map("decided_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz

  form       Form        @relation(fields: [formId], references: [id], onDelete: Restrict)
  versionRef FormVersion @relation(fields: [formId, formVersion], references: [formId, version], onDelete: Restrict)
  user       User        @relation("SubmissionAuthor", fields: [userId], references: [id], onDelete: Restrict)
  decider    User?       @relation("SubmissionDecider", fields: [decidedBy], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([formId, status])
  /// « Mes soumissions ».
  @@index([userId, createdAt(sort: Desc)], map: "submissions_user_id_created_at_idx")
  @@map("submissions")
}

// 11. Journal (14 §11). SQL ajouté dans la migration : trigger d'ajout seul.

model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  actorKind  ActorKind @map("actor_kind")
  /// Vide si l'acteur est `system` ou `cli`.
  actorId    String?   @map("actor_id") @db.Uuid
  action     String
  targetType String    @map("target_type")
  targetId   String?   @map("target_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?   @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_log")
}

// 10. Profil (14 §10). Index partiel (user_id, updated_at desc) where deleted_at
// is null ajouté en SQL.

model UserNote {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  /// HTML en liste blanche, nettoyé par le backend.
  content   String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_notes")
}

// 9. Modèles (14 §9). Suppression physique : les instances sont indépendantes.

model Template {
  id        String       @id @default(uuid(7)) @db.Uuid
  type      TemplateType
  name      String
  /// Copie de la structure, sans mappings ni plages.
  payload   Json
  createdBy String       @map("created_by") @db.Uuid
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([type, name])
  @@map("templates")
}

// 10 bis. Sauvegardes (14 §4 `backups`) : une ligne par archive du volume `backups`.

model Backup {
  id         String       @id @default(uuid(7)) @db.Uuid
  status     BackupStatus @default(running)
  /// Archive dans le volume `backups` (nom de fichier relatif à `BACKUPS_DIR`).
  filePath   String?      @map("file_path")
  sizeBytes  BigInt?      @map("size_bytes")
  error      String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  finishedAt DateTime?    @map("finished_at") @db.Timestamptz

  @@map("backups")
}
