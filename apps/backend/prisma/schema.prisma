// Modèle de données : voir references/conception/14-modele-donnees.md.
// Ce que Prisma n'exprime pas (CHECK, index partiels, trigger, extensions) est
// ajouté en SQL dans les migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1. Types enum (ordre de création, 14 §13). Ils doivent rester identiques à
// packages/shared/src/enums.ts (vérifié par src/prisma/enums.spec.ts).

enum BackupStatus {
  running
  ok
  failed

  @@map("backup_status")
}

enum LayoutKind {
  header
  footer

  @@map("layout_kind")
}

enum TopicSort {
  activity
  created

  @@map("topic_sort")
}

enum RevisionAction {
  edit
  delete
  hide
  unhide

  @@map("revision_action")
}

enum SourceType {
  upload
  gsheet
  onedrive

  @@map("source_type")
}

enum SourceStatus {
  ok
  unavailable
  auth_expired

  @@map("source_status")
}

enum CellType {
  empty
  text
  number
  bool
  date
  error

  @@map("cell_type")
}

enum FormMode {
  modification
  ligne
  ajout

  @@map("form_mode")
}

enum SubmissionStatus {
  pending
  validated
  rejected
  modified
  invalidated

  @@map("submission_status")
}

enum TemplateType {
  form
  page
  topic

  @@map("template_type")
}

enum ActorKind {
  user
  system
  cli

  @@map("actor_kind")
}

// 2. Comptes et sessions (14 §2).
// SQL ajouté dans la migration : extension citext, index uniques partiels
// (username) where deleted_at is null, (is_admin) where is_admin.

model User {
  id                    String    @id @default(uuid(7)) @db.Uuid
  username              String    @db.Citext
  passwordHash          String    @map("password_hash")
  isAdmin               Boolean   @default(false) @map("is_admin")
  mustChangeCredentials Boolean   @default(true) @map("must_change_credentials")
  personalPageId        String?   @map("personal_page_id") @db.Uuid
  disabledAt            DateTime? @map("disabled_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz
  version               Int       @default(1)

  sessions       Session[]
  auditLogs      AuditLog[]
  personalPage   Page?       @relation("PersonalPage", fields: [personalPageId], references: [id], onDelete: SetNull)
  publishedPages Page[]      @relation("PublishedBy")
  media          Media[]
  groups         UserGroup[]

  @@map("users")
}

model Session {
  /// Empreinte SHA-256 du jeton ; le jeton en clair n'est jamais stocké.
  id         String   @id
  userId     String   @map("user_id") @db.Uuid
  csrfSecret String   @map("csrf_secret")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  ip         String?
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LoginAttempt {
  id        String   @id @default(uuid(7)) @db.Uuid
  username  String   @db.Citext
  ip        String   @db.Inet
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([username, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

// 3. Groupes et droits (14 §3). SQL ajouté dans la migration : index unique
// partiel groups(name) where deleted_at is null, contraintes CHECK de
// group_permissions.

model Group {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String    @db.Citext
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  version     Int       @default(1)

  members     UserGroup[]
  permissions GroupPermission[]

  @@map("groups")
}

/// Les appartenances d'un compte ou d'un groupe supprimés sont conservées, mais
/// ignorées par la résolution des droits.
model UserGroup {
  userId    String   @map("user_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  group Group @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([userId, groupId])
  @@index([groupId])
  @@map("user_groups")
}

/// Cible : exactement une page ou un espace ; une page n'accorde que la lecture.
model GroupPermission {
  id             String   @id @default(uuid(7)) @db.Uuid
  groupId        String   @map("group_id") @db.Uuid
  pageId         String?  @map("page_id") @db.Uuid
  spaceId        String?  @map("space_id") @db.Uuid
  canRead        Boolean  @default(false) @map("can_read")
  canCreateTopic Boolean  @default(false) @map("can_create_topic")
  canPost        Boolean  @default(false) @map("can_post")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  group Group            @relation(fields: [groupId], references: [id], onDelete: Restrict)
  page  Page?            @relation(fields: [pageId], references: [id], onDelete: Restrict)
  space DiscussionSpace? @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  @@unique([groupId, pageId])
  @@unique([groupId, spaceId])
  @@index([pageId])
  @@index([spaceId])
  @@map("group_permissions")
}

// 4. Instance, thèmes, médias (14 §4). SQL ajouté dans la migration :
// CHECK settings, index unique partiel media(filename), données initiales.

model Setting {
  id                  Int      @id @default(1) @db.SmallInt
  landingPageId       String?  @map("landing_page_id") @db.Uuid
  defaultThemeId      String?  @map("default_theme_id") @db.Uuid
  backupRetentionDays Int      @default(7) @map("backup_retention_days")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  version             Int      @default(1)

  landingPage  Page?  @relation(fields: [landingPageId], references: [id], onDelete: SetNull)
  defaultTheme Theme? @relation(fields: [defaultThemeId], references: [id], onDelete: Restrict)

  @@map("settings")
}

model Theme {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique @db.Citext
  config    Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  version   Int      @default(1)

  pages    Page[]
  settings Setting[]

  @@map("themes")
}

model Media {
  id          String    @id @default(uuid(7)) @db.Uuid
  filename    String
  storagePath String    @map("storage_path")
  mime        String
  sizeBytes   BigInt    @map("size_bytes")
  alt         String?
  uploadedBy  String    @map("uploaded_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  uploader User @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@map("media")
}

// 5. Pages (14 §5).

model Page {
  id              String    @id @default(uuid(7)) @db.Uuid
  name            String
  /// Thème de la version publiée ; vide = thème par défaut.
  themeId         String?   @map("theme_id") @db.Uuid
  showHeader      Boolean   @default(true) @map("show_header")
  showFooter      Boolean   @default(true) @map("show_footer")
  draftConfig     Json      @default("{}") @map("draft_config")
  publishedConfig Json?     @map("published_config")
  publishedAt     DateTime? @map("published_at") @db.Timestamptz
  publishedBy     String?   @map("published_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  version         Int       @default(1)

  theme       Theme?            @relation(fields: [themeId], references: [id], onDelete: SetNull)
  publisher   User?             @relation("PublishedBy", fields: [publishedBy], references: [id], onDelete: Restrict)
  personalOf  User[]            @relation("PersonalPage")
  landingOf   Setting[]
  permissions GroupPermission[]
  spaces      DiscussionSpace[]

  @@map("pages")
}

model LayoutPart {
  kind            LayoutKind @id
  draftConfig     Json       @default("{}") @map("draft_config")
  publishedConfig Json?      @map("published_config")
  publishedAt     DateTime?  @map("published_at") @db.Timestamptz
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  version         Int        @default(1)

  @@map("layout_parts")
}

// 6. Discussions (14 §6). `discussion_spaces` est créée dès l'étape 4, pour
// que `group_permissions` puisse la viser ; elle reste vide jusqu'à l'étape 8.

model DiscussionSpace {
  id        String    @id @default(uuid(7)) @db.Uuid
  pageId    String    @map("page_id") @db.Uuid
  /// Id du bloc dans la page.
  blockId   String    @unique @map("block_id") @db.Uuid
  name      String
  sortMode  TopicSort @default(activity) @map("sort_mode")
  /// Ligne créée à la publication de la page.
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  page        Page              @relation(fields: [pageId], references: [id], onDelete: Restrict)
  permissions GroupPermission[]

  @@map("discussion_spaces")
}

// 11. Journal (14 §11). SQL ajouté dans la migration : trigger d'ajout seul.

model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  actorKind  ActorKind @map("actor_kind")
  /// Vide si l'acteur est `system` ou `cli`.
  actorId    String?   @map("actor_id") @db.Uuid
  action     String
  targetType String    @map("target_type")
  targetId   String?   @map("target_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?   @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_log")
}
