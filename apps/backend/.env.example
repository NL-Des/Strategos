# Lancement local (pnpm dev) : base exposée par `pnpm db:up`.
DATABASE_URL=postgresql://strategos:strategos@localhost:5432/strategos
PORT=3000
# Origines autorisées (CSRF) : le serveur Vite de `pnpm dev`.
APP_ORIGINS=http://localhost:5173

