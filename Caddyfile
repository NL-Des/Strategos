{
	# Le certificat interne n'a pas à être installé dans le conteneur (lecture seule).
	skip_install_trust
}

# DOMAIN=localhost → certificat interne de Caddy (HTTPS local) ;
# un vrai nom de domaine → certificat Let's Encrypt obtenu et renouvelé automatiquement.
{$DOMAIN:localhost} {
	encode zstd gzip

	# Vide par défaut. TLS_DIRECTIVE="tls internal" dans .env impose le certificat interne
	# de Caddy pour un nom qui n'existe que sur un réseau interne (deploiement.md §11).
	{$TLS_DIRECTIVE}

	# En-têtes de sécurité (bilan-securite.md, M1). `?` : seulement si le backend n'a pas
	# posé le sien (les images et pièces jointes sont servies avec une CSP plus stricte).
	header {
		# HSTS=max-age=0 dans .env le désactive (réseau interne, certificat non installé).
		Strict-Transport-Security "{$HSTS:max-age=31536000}"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "same-origin"
		# Scripts : le site et le sélecteur de fichiers Google (écran Sources).
		# Images : `https:` pour les liens externes des catalogues.
		?Content-Security-Policy "default-src 'self'; script-src 'self' https://apis.google.com; frame-src https://docs.google.com https://drive.google.com; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' wss://{host}; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# API REST et WebSocket du chat (/api/v1/ws).
	handle /api/* {
		reverse_proxy backend:3000
	}

	handle {
		reverse_proxy frontend:80
	}
}
